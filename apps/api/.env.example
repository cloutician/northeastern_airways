NODE_ENV=development
PORT=3000
# PostgreSQL: Docker maps container 5432 → host 5433 (avoids conflict with local Postgres on 5432)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/northeastern_airways
# Comma-separated browser origins; empty uses permissive dev CORS
CORS_ORIGINS=http://localhost:5173
# Local demo placeholder only. Use a unique random secret (32+ characters) for deployment.
JWT_SECRET=development-only-change-before-deployment
# All booking confirmations are simulated. No payment-provider keys are used.
# Set to true when connecting to managed Postgres that requires TLS
# DATABASE_SSL=false
# DATABASE_SSL_REJECT_UNAUTHORIZED=true
